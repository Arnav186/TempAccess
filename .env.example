NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temp_ai_platform?schema=public
SESSION_SECRET=random-32-characters
ADMIN_EMAIL=your-email-address
ADMIN_PASSWORD=minimum-16-characters
# Comma-separated provider:model entries. A model must be present here and have its API key set.
MODEL_ALLOWLIST=openai:gpt-4o-mini,gemini:gemini-3.8-flash,anthropic:claude-3-5-haiku-latest
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
